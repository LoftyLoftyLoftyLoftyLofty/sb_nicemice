//
//      { "spawner" : { "variationSource" : "/spawners/nicemice_cargoship_spawns.config",
//                      "variationSet" : "medic" } }
//
//  TO ADD YOUR OWN RACE OR NPC TYPE TO THIS SHIP, patch this file. No dungeon
//  json, no objectIds:
//
//      nicemice_cargoship_spawns.config.patch
//      [
//        { "op" : "add", "path" : "/medic/0/npcSpeciesOptions/-", "value" : "yourrace" }
//      ]
//
//  Or add a whole variation of your own to a set:
//
//      [
//        { "op" : "add", "path" : "/quartermaster/-", "value" : { ...variation... } }
//      ]

