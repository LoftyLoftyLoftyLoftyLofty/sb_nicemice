//  SHIP DIAGNOSTIC DISPLAY
//
//  One state per ship area. These names must match DISPLAY_STATES in
//  nicemice_diagnosticdisplay.lua exactly -- the script sets them by name.
//
//  Each state points at a frame in the display sheet, so the .frames file
//  needs a matching alias for every name below.

{
  "animatedParts": {
    "stateTypes": {
      "displayState": {
        "default": "bridge",
        "states": {
          "bridge": {
            "frames": 1
          },
          "cargohold0": {
            "frames": 1
          },
          "cargohold1": {
            "frames": 1
          },
          "cargohold2": {
            "frames": 1
          },
          "engineering": {
            "frames": 1
          },
          "reactor": {
            "frames": 1
          },
          "lifesupport": {
            "frames": 1
          },
          "galley": {
            "frames": 1
          },
          "quarters0": {
            "frames": 1
          },
          "quarters1": {
            "frames": 1
          },
          "medbay": {
            "frames": 1
          },
          "armory": {
            "frames": 1
          },
          "hangar": {
            "frames": 1
          },
          "airlockfore": {
            "frames": 1
          },
          "airlockaft": {
            "frames": 1
          },
          "dockingfield": {
            "frames": 1
          },
          "sensors": {
