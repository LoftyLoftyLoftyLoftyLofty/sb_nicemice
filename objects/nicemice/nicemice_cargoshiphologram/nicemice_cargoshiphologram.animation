//  M.A.U.S. CARGO SHIP HOLOGRAM
//
//  One displayState per row in nicemice_cargoshiphologram.frames -- the
//  names are taken straight from that file, and the script sets them by
//  name, so the three must stay in agreement.
//
//  Each row is 8 frames at the 0.75s cycle the object used before, so a
//  selected area keeps animating rather than freezing on one frame.
//
//  The pedestal is a single static 136x64 frame drawn ON TOP of the hologram --
//  the object's imageLayers lists it after the hologram, and later layers win.
//  It needs no state and no frame substitution. Only the hologram layer is
//  fullbright, matching the original imageLayers setup.

{
  "animatedParts": {
    "stateTypes": {
      "displayState": {
        "default": "default",
        "states": {
          "default": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "shields": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "ears": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "comms": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "engine1": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "tail": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "fuel": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "crew": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "vents": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "torpedorack": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "rackhall": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "cargoobservationdeck": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "centerdeck": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "elevator": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "munitions": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "entry": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "cargo": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "decontamination": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "shiplocker": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "flightdeck": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "engineering": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "tools": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "mechchest": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          },
          "engine2": {
            "frames": 8,
            "cycle": 0.75,
            "mode": "loop"
          }
        }
      }
    },
    "parts": {
      "hologram": {
        "properties": {
          "centered": false,
          "fullbright": true,
          "zLevel": 0
        },
        "partStates": {
          "displayState": {
            "default": {
              "properties": {
                "image": "<partImage>:default.<frame>"
              }
            },
            "shields": {
              "properties": {
                "image": "<partImage>:shields.<frame>"
              }
            },
            "ears": {
