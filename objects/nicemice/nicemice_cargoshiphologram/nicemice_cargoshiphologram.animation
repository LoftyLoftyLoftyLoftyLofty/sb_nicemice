              }
            },
            "decontamination": {
              "properties": {
                "image": "<partImage>:decontamination.<frame>"
              }
            },
            "shiplocker": {
              "properties": {
                "image": "<partImage>:shiplocker.<frame>"
              }
            },
            "flightdeck": {
              "properties": {
                "image": "<partImage>:flightdeck.<frame>"
              }
            },
            "engineering": {
              "properties": {
                "image": "<partImage>:engineering.<frame>"
              }
            },
            "tools": {
              "properties": {
                "image": "<partImage>:tools.<frame>"
              }
            },
            "mechchest": {
              "properties": {
                "image": "<partImage>:mechchest.<frame>"
              }
            },
            "engine2": {
              "properties": {
                "image": "<partImage>:engine2.<frame>"
              }
            }
          }
        }
      },
      "pedestal": {
        "properties": {
          "centered": false,
          "zLevel": 1,
          "image": "<partImage>"
        }
      }
    }
  },
  "sounds": {
    "advance": []
  }
}
