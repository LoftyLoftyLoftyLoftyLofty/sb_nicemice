  //  Container must not auto-close while the player is fiddling with options.
  "autoCloseCooldown" : 3600,

  //  Where the unit wakes up, relative to the station.
  "petSpawnOffset" : [0, 2],

  "inventoryIcon" : "nicemice_petstation_icon.png",
  "orientations" : [
    {
      "image" : "nicemice_petstation.png:<color>.<key>",
      "imagePosition" : [-8, 0],
      "direction" : "left",
      "flipImages" : true,
      "spaceScan" : 0.1,
      "anchors" : [ "bottom" ]
    },
    {
      "image" : "nicemice_petstation.png:<color>.<key>",
      "imagePosition" : [-8, 0],
      "direction" : "right",
      "spaceScan" : 0.1,
      "anchors" : [ "bottom" ]
    }
  ],

  "scripts" : [ "nicemice_petstation.lua" ],
  "scriptDelta" : 5,

  "animation" : "nicemice_petstation.animation",
  "animationParts" : { "station" : "nicemice_petstation.png" },
  "animationPosition" : [-8, 0]
}
