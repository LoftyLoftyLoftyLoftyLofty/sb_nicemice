//  M.A.U.S. PET STATION
//
//  One-slot container. Socket a nicemice_shippet item to wake the unit inside.
//  See nicemice_petstation.lua.

{
  "objectName" : "nicemice_petstation",
  "colonyTags" : ["nicemice"],
  "rarity" : "Uncommon",
  "objectType" : "container",
  "category" : "storage",
  "price" : 250,
  "printable" : false,
  "description" : "A docking cradle for M.A.U.S. utility units. Socket a dormant unit to bring it online.",
  "shortdescription" : "Pet Station",
  "race" : "generic",

  "damageTeam" : { "type" : "friendly", "team" : 0 },

  //  One pet, one slot.
  "slotCount" : 1,

  //  Custom panel. Modelled on the pet tether's; replace the path once the
  //  bespoke interface config exists.
