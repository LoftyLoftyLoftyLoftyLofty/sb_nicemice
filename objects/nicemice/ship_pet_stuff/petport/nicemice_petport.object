//  M.A.U.S. PETPORT
//
//  One-slot container. Socket a nicemice_ship_pet item to wake the unit inside.
//  See nicemice_petport.lua.

{
  "objectName" : "nicemice_petport",
  "colonyTags" : ["nicemice"],
  "rarity" : "Rare",
  "objectType" : "container",
  "category" : "storage",
  "price" : 550,
  "printable" : false,
  "description" : "A Petport for M.A.U.S. utility units. Socket a dormant unit to bring it online.",
  "shortdescription" : "M.A.U.S. Petport",
  "race" : "nicemice",

  //  assistant type here so "hostile" ignores us and the player doesn't view the entity hp bar on mouseover
  "damageTeam" : { "type" : "assistant", "team" : 0 },

  //  One pet, one slot.
  "slotCount" : 1,

  //  Custom panel. Modelled on the pet tether's; replace the path once the
  //  bespoke interface config exists.
  "uiConfig" : "/interface/chests/pettether.config",

  //  Container must not auto-close while the player is fiddling with options.
  "autoCloseCooldown" : 3600,
  "frameCooldown" : 5,

  //  Where the unit wakes up, relative to the station.
  "petSpawnOffset" : [0, 2],

  "inventoryIcon" : "nicemice_petporticon.png",
  "orientations" : [
    {
      "imageLayers" : 
	  [ 		
		{ "image" : "nicemice_petport.png:<color>.<key>.<frame>", "fullbright" : true },
		{ "image" : "nicemice_petportlit.png:<color>" }
	  ],
      "imagePosition" : [-48, -24],
      "direction" : "left",
      "flipImages" : true,
      "spaceScan" : 0.1,
      "anchors" : [ "bottom" ],
	  
	  "frames" : 1,
	  "animationCycle" : 1.2
    },
    {
      "imageLayers" : 
	  [ 		
		{ "image" : "nicemice_petport.png:<color>.<key>.<frame>", "fullbright" : true },
		{ "image" : "nicemice_petportlit.png:<color>" }
	  ],
      "imagePosition" : [-48, -24],
      "direction" : "right",
      "spaceScan" : 0.1,
      "anchors" : [ "bottom" ],
	  
	  "frames" : 1,
	  "animationCycle" : 1.2
    }
  ],

  "scripts" : [ "nicemice_petport.lua" ],
  "scriptDelta" : 5,

  "animation" : "nicemice_petport.animation",
  "animationParts" : 
  { 
	"base_lit" : "nicemice_petportlit.png",
	"base_fullbright" : "nicemice_petport.png"
  },
  "animationPosition" : [-48, -24]
}
